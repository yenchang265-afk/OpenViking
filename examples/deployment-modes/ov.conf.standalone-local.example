{
  "server": {
    "deployment_mode": "standalone",
    "host": "127.0.0.1",
    "port": 1933,
    "auth_mode": "api_key",
    "root_api_key": "${OPENVIKING_ROOT_API_KEY}"
  },
  "storage": {
    "workspace": "./data",
    "agfs": {
      "backend": "local"
    },
    "vectordb": {
      "backend": "local"
    }
  },
  "embedding": {
    "dense": {
      "provider": "ollama",
      "model": "qwen3-embedding:0.6b",
      "api_base": "http://127.0.0.1:11434/v1",
      "dimension": 1024
    }
  },
  "vlm": {
    "provider": "litellm",
    "model": "ollama_chat/qwen3:8b",
    "api_key": "ollama",
    "api_base": "http://127.0.0.1:11434",
    "temperature": 0.0,
    "timeout": 300
  }
}
